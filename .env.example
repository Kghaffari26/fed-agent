# FRED (free key at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Anthropic (used by agents/macro/analyze.py through agents_core.llm)
ANTHROPIC_API_KEY=

# Optional BLS fallback (off by default; config/macro.toml [settings].use_bls_fallback)
BLS_API_KEY=

# Per-run spend cap in USD, enforced by agents_core.costs
MAX_RUN_USD=0.25
