# Copy to .env for local runs (agents-run loads it without overriding set variables).

# FRED (free key at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Anthropic, read by agents_core.llm. It falls back to AGENTS_ANTHROPIC_API_KEY when
# ANTHROPIC_API_KEY is unset (some cloud dev environments reserve that name).
ANTHROPIC_API_KEY=
# AGENTS_ANTHROPIC_API_KEY=

# Per-run LLM spend cap in USD, enforced by agents_core.costs (CI sets 0.25 via
# agent-macro.yml's max_run_usd).
AGENTS_CORE_MAX_RUN_USD=0.25

# Optional BLS fallback (off by default; config/macro.toml [settings].use_bls_fallback)
BLS_API_KEY=
